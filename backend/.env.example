# ==========================================
# PRODUCTION SYSTEM ENVIRONMENT VARIABLES
# ==========================================
# Copy this file to .env and configure your environment

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# PostgreSQL database connection URL
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/production_system

# Database connection pool settings
DATABASE_POOL_SIZE=10
DATABASE_ECHO=false

# ==========================================
# MODBUS SERVER CONFIGURATION
# ==========================================
# Modbus TCP server settings for PLC communication
MODBUS_HOST=0.0.0.0
MODBUS_PORT=502

# ==========================================
# API SERVER CONFIGURATION
# ==========================================
# FastAPI server settings
API_HOST=0.0.0.0
API_PORT=8000
API_TITLE=Production System API
API_VERSION=2.0.0

# ==========================================
# CORS CONFIGURATION
# ==========================================
# Comma-separated list of allowed origins for CORS
# Use "*" for all origins in development (not recommended for production)
CORS_ORIGINS=*

# ==========================================
# SECURITY CONFIGURATION
# ==========================================
# JWT authentication settings
# IMPORTANT: Change SECRET_KEY in production!
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==========================================
# LOGGING CONFIGURATION
# ==========================================
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_FILE=production_system.log

# ==========================================
# DATA PROCESSING CONFIGURATION
# ==========================================
# Buffer size for processing production data
DATA_BUFFER_SIZE=1000

# Prefix for batch ID generation
BATCH_ID_PREFIX=BATCH

# ==========================================
# WEBSOCKET CONFIGURATION
# ==========================================
# Maximum number of concurrent WebSocket connections
WEBSOCKET_MAX_CONNECTIONS=100

# ==========================================
# DEVELOPMENT/DEBUG FLAGS
# ==========================================
# Enable debug mode (set to true for development)
DEBUG=false

# ==========================================
# EXAMPLE CONFIGURATIONS FOR DIFFERENT ENVIRONMENTS
# ==========================================

# DEVELOPMENT ENVIRONMENT
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/production_system_dev
# DEBUG=true
# LOG_LEVEL=DEBUG

# PRODUCTION ENVIRONMENT
# DATABASE_URL=postgresql+asyncpg://produser:secure_password@prod-db:5432/production_system
# SECRET_KEY=your-very-secure-secret-key-here
# DEBUG=false
# LOG_LEVEL=INFO
# CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# DOCKER ENVIRONMENT
# DATABASE_URL=postgresql+asyncpg://postgres:password@db:5432/production_system
# MODBUS_HOST=0.0.0.0
# API_HOST=0.0.0.0

# ==========================================
# NOTES
# ==========================================
# 1. Always use strong passwords and secure keys in production
# 2. Restrict CORS_ORIGINS to specific domains in production
# 3. Use environment-specific database URLs
# 4. Consider using secrets management for sensitive values
# 5. Monitor LOG_LEVEL settings for performance in production

# ==========================================
# QUICK START GUIDE
# ==========================================
# 1. Copy this file: cp .env.example .env
# 2. Edit .env with your specific values
# 3. Source the environment: source .env (optional)
# 4. Run the application: python main.py

# ==========================================
# VALIDATION
# ==========================================
# You can verify your configuration by running:
# python -c "from app.core.config import Settings; print(Settings())"
